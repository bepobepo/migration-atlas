SUBJECT-CODE="MCH";
SUBJECT-AREA="";
DESCRIPTION="Table 5.1: Long-term immigration by citizenship status (flows)";
TITLE="Long-term immigrants (flow) by Country, Citizenship, Sex and Year";
CONTENTS="Long-term immigrants (flow)";
STUB="Country","Citizenship","Sex";
HEADING="Year";
VALUES("Country")="Armenia","Azerbaijan","Belarus","Georgia","Kazakhstan","Kyrgyzstan","Russian Federation","Ukraine","Uzbekistan";
VALUES("Citizenship")="Total inflow","Total citizens","Total non-citizens","Total stateless","Unknown";
VALUES("Sex")="Both sexes","Men","Women";
VALUES("Year")="2001","2009","2010","2011","2012","2013","2014","2015","2016","2017","2018";
CODES("Country")="051","031","112","268","398","417","643","804","860";
CODES("Citizenship")="5","6","4","9","12";
CODES("Sex")="1","2","3";
