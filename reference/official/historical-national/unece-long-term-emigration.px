SUBJECT-CODE="MCH";
SUBJECT-AREA="";
DESCRIPTION="Table 6.1: Long-term emigration by citizenship status (flows)";
TITLE="Long-term emigrants (flow) by Country, Citizenship, Sex and Year";
CONTENTS="Long-term emigrants (flow)";
STUB="Country","Citizenship","Sex";
HEADING="Year";
VALUES("Country")="Armenia","Azerbaijan","Belarus","Georgia","Kazakhstan","Kyrgyzstan","Republic of Moldova","Russian Federation","Ukraine","Uzbekistan";
VALUES("Citizenship")="Total outflow","Total citizens","Total non-citizens","Total stateless","Unknown";
VALUES("Sex")="Both sexes","Men","Women";
VALUES("Year")="2009","2010","2011","2012","2013","2014","2015","2016","2017","2018";
CODES("Country")="051","031","112","268","398","417","498","643","804","860";
CODES("Citizenship")="8","6","4","9","12";
CODES("Sex")="1","2","3";
DOMAIN("Country")="Country";
DOMAIN("Citizenship")="M_BirtPlceCitizen";
DOMAIN("Sex")="M_Sex";
ELIMINATION("Citizenship")=YES;
